.venv/
__pycache__/
*.pyc
.DS_Store
.env

# Databases -- pattern-based, not an exact filename. An earlier exact-filename rule
# ("data/finance.db") let a macOS duplicate-save artifact named "data/finance 2.db" slip
# through and get committed. Any .db/.sqlite anywhere is user financial data and must
# never be committed; see known issue #8 in CLAUDE.md.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

data/imports/*
data/exports/*
backups/*
logs/*
reports/*

*.xlsx
*.xls
*.csv

# Python build artifacts
*.egg-info/
build/
dist/

!data/imports/.gitkeep
!data/exports/.gitkeep

# The blank Excel template is generated (make template), but it's also the easiest way for
# someone to see the expected shape of their data without cloning the repo and running
# Python -- committed on purpose so it's browsable and downloadable straight from GitHub.
# Regenerate and re-commit it whenever SHEETS/EXAMPLE_ROWS in exports/excel_template.py change.
!data/exports/finance_template.xlsx
